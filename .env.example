# Copy this file to .env and add your provider keys locally.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# API principals are stored locally; create the file with
# scripts/api_auth/manage_tokens.py and never commit it.
ETERNAL_AUTH_FILE=./secrets/auth.json
QAP_REQUIRE_ATTESTATION=0
QAP_MAX_TOKEN_TTL=3600

# Optional model overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
